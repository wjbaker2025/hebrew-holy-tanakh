{
  // Python package layout
  "python.analysis.extraPaths": ["hebrew-bible-cli/src"],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  // Unicode Hebrew safety
  // Hebrew requires non-basic ASCII, but invisible/ambiguous characters should still be visible.
  "editor.unicodeHighlight.nonBasicASCII": false,
  "editor.unicodeHighlight.invisibleCharacters": true,
  "editor.unicodeHighlight.ambiguousCharacters": true,
  "editor.renderControlCharacters": true,
  // General formatting defaults
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  "editor.wordWrap": "on",
  "editor.wordWrapColumn": 80,
  "editor.rulers": [80],
  // Python: Ruff handles formatting, fixes, and import sorting.
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  // TOML: pyproject.toml formatting.
  "[toml]": { "editor.defaultFormatter": "tamasfe.even-better-toml" },
  // JSON: use VS Code's built-in JSON formatter to avoid requiring Prettier.
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  // JSONC: VS Code settings files allow comments/trailing commas.
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  // Markdown: auto-formatting disabled by default.
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.formatOnSave": false
  },
  "markdown.validate.enabled": true,
  "markdownlint.config": {
    "MD004": false,
    "MD013": {
      "line_length": 100,
      "heading_line_length": 100,
      "code_blocks": false,
      "tables": false,
      "strict": false
    },
    "MD024": {
      "allow_different_nesting": true
    },
    "MD029": {
      "style": "one"
    },
    "MD033": false,
    "MD040": true
  },
  // Hide generated/cache/editor files from Explorer
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.cache": true,
    "**/.env": true,
    "**/.history": true,
    "**/.idea": true,
    "**/.mypy_cache": true,
    "**/.nvm": true,
    "**/.pyenv": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.venv": true,
    "**/.virtualenvs": true,
    "**/.vs": true,
    "**/.vscode-test": true,
    "**/build": true,
    "**/coverage": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/out": true
  },
  // Keep generated/cache files out of search
  "search.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.venv": true,
    "**/venv": true,
    "**/dist": true,
    "**/build": true,
    "**/coverage": true,
    "**/*.sqlite": true,
    "**/*.db": true,
    "**/*.log": true
  },
  // Minimal file nesting relevant to this repo
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "pyproject.toml": "uv.lock, poetry.lock, pdm.lock, requirements*.txt, setup.cfg, setup.py",
    "*.py": "${capture}.pyi",
    "*.json": "${capture}.schema.json, ${capture}.sample.json, ${capture}.example.json",
    "*.md": "${capture}.pdf, ${capture}.docx, ${capture}.html"
  }
}
